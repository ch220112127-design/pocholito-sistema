# Copia este archivo como .env y llena los valores de Railway

# Railway te da estas variables automáticamente cuando conectas MySQL
MYSQLHOST=containers-us-west-xxx.railway.app
MYSQLPORT=6543
MYSQLUSER=root
MYSQLPASSWORD=tu_password_de_railway
MYSQLDATABASE=railway

# Puerto (Railway lo asigna automático)
PORT=3000
